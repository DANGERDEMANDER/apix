# Normalise line endings: LF in the repo, whatever the working tree uses.
* text=auto eol=lf

# Explicitly binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# Keep these as LF
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf